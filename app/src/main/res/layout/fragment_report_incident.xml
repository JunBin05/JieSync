<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/water_blue"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Report Facility Fault"
        android:textColor="@color/dark_slate"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Section 1 Header -->
    <TextView
        android:id="@+id/tv_section_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="1. Location &amp; Asset"
        android:textColor="@color/dark_slate"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tv_header"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Location Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_location"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/pure_white"
        app:cardCornerRadius="12dp"
        app:strokeColor="#CBD5E1"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/tv_section_1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 KK10 - Block B • Ground Floor Male Restroom"
                android:textColor="@color/cobalt_blue"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_scan_tag"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/water_blue"
                android:text="Scan Door QR / NFC Tag"
                android:textAllCaps="false"
                android:textColor="@color/cobalt_blue" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Section 2 Header -->
    <TextView
        android:id="@+id/tv_section_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="2. Photo Evidence &amp; AI Triage"
        android:textColor="@color/dark_slate"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/card_location"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Photo Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_photo_triage"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/pure_white"
        app:cardCornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/tv_section_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="[Camera Photo Preview / AI Triage Frame]"
            android:textColor="@color/slate_gray" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Submit CTA Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_submit_report"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/emerald_green"
        android:text="Submit Report (+10 XP)"
        android:textAllCaps="false"
        app:cornerRadius="8dp"
        app:layout_constraintTop_toBottomOf="@id/card_photo_triage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>